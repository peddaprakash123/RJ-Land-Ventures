# --- MongoDB (server-side only; never expose this URL in the frontend) ---
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/"
MONGODB_DB="rj_land_ventures"

# --- Express API ---
PORT=4000
API_KEY="generate-a-long-random-key"
CLIENT_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# --- Vite frontend ---
# Keep the API on the same origin; Vite proxies /api to the Express server.
VITE_API_BASE_URL="/api"
# Must be the same value as API_KEY.
VITE_API_KEY="same-value-as-API_KEY"
# Indian numbers can be entered as 10 digits; 91 is added automatically.
VITE_WHATSAPP_NUMBER="916300409615"

# --- Cloudinary image uploads (server-side only) ---
# Never expose the API secret to the frontend or prefix it with VITE_.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="rj-land-ventures/properties"
